{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ledgerflow.settlement.capture.events.v1",
  "description": "EventEnvelope<one of settlement.CapturesIssued, settlement.IssueFailed>. Closed content model on purpose: with additionalProperties true, dropping a field would pass BACKWARD.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": "integer"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "oneOf": [
        {
          "title": "settlement.CapturesIssued",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "paymentId": {
              "type": "string",
              "format": "uuid"
            },
            "captureIds": {
              "type": "array",
              "minItems": 0,
              "items": {
                "type": "string",
                "format": "uuid"
              }
            }
          },
          "required": [
            "paymentId",
            "captureIds"
          ]
        },
        {
          "title": "settlement.IssueFailed",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "paymentId": {
              "type": "string",
              "format": "uuid"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "paymentId",
            "reason"
          ]
        }
      ]
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "aggregateId",
    "aggregateVersion",
    "occurredAt",
    "payload"
  ]
}

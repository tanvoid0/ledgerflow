{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ledgerflow.ledger.hold.commands.v1",
  "description": "EventEnvelope<one of ledger.ReserveWallets, ledger.ReleaseWallets, ledger.CaptureHolds>. Closed content model on purpose: with additionalProperties true, dropping a field would pass BACKWARD.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": "integer"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "oneOf": [
        {
          "title": "ledger.ReserveWallets",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reference": {
              "type": "string",
              "format": "uuid"
            },
            "accountId": {
              "type": "string",
              "format": "uuid"
            },
            "wallets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "amount": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "minorUnits": {
                  "type": "integer"
                },
                "currency": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 3
                }
              },
              "required": [
                "minorUnits",
                "currency"
              ]
            }
          },
          "required": [
            "reference",
            "accountId",
            "wallets",
            "amount"
          ]
        },
        {
          "title": "ledger.ReleaseWallets",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reference": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "reference"
          ]
        },
        {
          "title": "ledger.CaptureHolds",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "reference": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "reference"
          ]
        }
      ]
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "aggregateId",
    "aggregateVersion",
    "occurredAt",
    "payload"
  ]
}

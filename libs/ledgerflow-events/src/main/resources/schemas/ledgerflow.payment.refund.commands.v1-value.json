{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ledgerflow.payment.refund.commands.v1",
  "description": "EventEnvelope<payment.RefundOrder>. Ticketing asks payment to reverse one settled payment. Closed content model on purpose: with additionalProperties true, dropping a field would pass BACKWARD.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": "integer"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "title": "payment.RefundOrder",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paymentId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "paymentId"
      ]
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "aggregateId",
    "aggregateVersion",
    "occurredAt",
    "payload"
  ]
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ledgerflow.settlement.capture.commands.v1",
  "description": "EventEnvelope<one of settlement.IssueCaptures, settlement.RevokeCaptures>. Closed content model on purpose: with additionalProperties true, dropping a field would pass BACKWARD.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": "integer"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "oneOf": [
        {
          "title": "settlement.IssueCaptures",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "paymentId": {
              "type": "string",
              "format": "uuid"
            },
            "accountId": {
              "type": "string",
              "format": "uuid"
            },
            "holds": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "holdId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "wallet": {
                    "type": "string"
                  }
                },
                "required": [
                  "holdId",
                  "wallet"
                ]
              }
            },
            "amount": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "minorUnits": {
                  "type": "integer"
                },
                "currency": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 3
                }
              },
              "required": [
                "minorUnits",
                "currency"
              ]
            }
          },
          "required": [
            "paymentId",
            "accountId",
            "holds",
            "amount"
          ]
        },
        {
          "title": "settlement.RevokeCaptures",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "paymentId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "paymentId"
          ]
        }
      ]
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "aggregateId",
    "aggregateVersion",
    "occurredAt",
    "payload"
  ]
}

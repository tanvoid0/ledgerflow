{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ledgerflow.payment.requested.events.v1",
  "description": "EventEnvelope<payment.PaymentRequested>. Closed content model on purpose: with additionalProperties true, dropping a field would pass BACKWARD.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": "integer"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "title": "payment.PaymentRequested",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paymentId": {
          "type": "string",
          "format": "uuid"
        },
        "accountId": {
          "type": "string",
          "format": "uuid"
        },
        "wallets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "amount": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minorUnits": {
              "type": "integer"
            },
            "currency": {
              "type": "string",
              "minLength": 3,
              "maxLength": 3
            }
          },
          "required": [
            "minorUnits",
            "currency"
          ]
        },
        "beneficiary": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "paymentId",
        "accountId",
        "wallets",
        "amount"
      ]
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "aggregateId",
    "aggregateVersion",
    "occurredAt",
    "payload"
  ]
}

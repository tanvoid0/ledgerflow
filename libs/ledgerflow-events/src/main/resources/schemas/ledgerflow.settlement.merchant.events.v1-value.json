{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ledgerflow.settlement.merchant.events.v1",
  "description": "EventEnvelope<settlement.MerchantSettled>. Closed content model on purpose: with additionalProperties true, dropping a field would pass BACKWARD.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "integer"
    },
    "aggregateId": {
      "type": "string",
      "format": "uuid"
    },
    "aggregateVersion": {
      "type": "integer"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "correlationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "title": "settlement.MerchantSettled",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "merchantId": {
          "type": "string"
        },
        "businessDate": {
          "type": "string",
          "format": "date"
        },
        "currency": {
          "type": "string"
        },
        "netMinor": {
          "type": "integer"
        },
        "dayNetTotalMinor": {
          "type": "integer"
        }
      },
      "required": [
        "merchantId",
        "businessDate",
        "currency",
        "netMinor",
        "dayNetTotalMinor"
      ]
    }
  },
  "required": [
    "eventId",
    "eventType",
    "schemaVersion",
    "aggregateId",
    "aggregateVersion",
    "occurredAt",
    "payload"
  ]
}

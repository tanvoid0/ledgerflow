<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.ledgerflow</groupId>
        <artifactId>ledgerflow</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>ledgerflow-starter-web</artifactId>
    <name>ledgerflow-starter-web</name>
    <description>Cross-cutting plumbing every service gets by depending on it: request id filter, traces, metrics and logs shipped over OTLP.</description>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
            <optional>true</optional>     <!-- compile against it; the service decides whether it is there -->
        </dependency>
        <dependency>
            <!-- tracing bridge, OTLP exporters for all three signals; not optional: a service nobody can see is not done -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <!-- Boot exports OTel logs but does not feed them; this is the logback side of that -->
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-logback-appender-1.0</artifactId>
        </dependency>
        <dependency>
            <!-- every service serves HTTP; @ConditionalOnWebApplication(SERVLET) means a CronJob pod gets nothing -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
    </dependencies>
    <!-- again: no spring-boot-maven-plugin in a library -->
</project>

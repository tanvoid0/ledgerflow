    {
      "key": "derived-query-typos-fail-at",
      "do": "Derived query typos fail at startup."
    },
    {
      "key": "jpql-table-names",
      "do": "JPQL ≠ table names."
    },
    {
      "key": "modifying-required-dml-query",
      "do": "`@Modifying` required for DML `@Query`."
    },
    {
      "key": "findbyid-optional-not-emptyresultdataaccessexcep",
      "do": "`findById` → `Optional`, not `EmptyResultDataAccessException`."

      "do": "Use built-in `save`, `findById`, `findAll`, `deleteById`."
    },
    {
      "key": "write-derived-query-findby-true",
      "do": "Write a derived query (`findBy…And…True`, `countBy`, `existsBy`)."
    },
    {
      "key": "write-query-jpql-named-parameters",
      "do": "Write `@Query` JPQL with `:named` parameters."
    },
    {
      "key": "add-modifying-on-update-delete",
      "do": "Add `@Modifying` on UPDATE/DELETE queries."

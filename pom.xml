<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>io.ledgerflow</groupId>
    <artifactId>ledgerflow</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ledgerflow</name>
    <description>A double-entry payment ledger with holds, capture and settlement, run across services that talk by events.</description>

    <properties>
        <java.version>25</java.version>
        <springdoc.version>3.1.1</springdoc.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <!-- the logback bridge is not in Boot's BOM; 2.28 is the instrumentation line built against OTel 1.62, which Boot 4.1 manages -->
        <opentelemetry-logback-appender.version>2.28.0-alpha</opentelemetry-logback-appender.version>
        <!-- surefire reads this as the JUnit tags to skip; -DexcludedGroups=none runs them -->
        <excludedGroups>perf</excludedGroups>
        <!-- spring-boot:run would otherwise pin the JIT at C1 (-XX:TieredStopAtLevel=1) for faster startup,
             and every number in docs/perf would be a dev-mode number; the services measured are the ones run -->
        <spring-boot.run.optimizedLaunch>false</spring-boot.run.optimizedLaunch>
        <onnxruntime.version>1.22.0</onnxruntime.version>
        <archunit.version>1.4.1</archunit.version>
    </properties>

    <modules>
        <module>libs/ledgerflow-events</module>
        <module>libs/ledgerflow-starter-web</module>
        <module>libs/ledgerflow-starter-messaging</module>
        <module>services/account-service</module>
        <module>services/ledger-service</module>
        <module>services/notification-service</module>
        <module>services/balance-service</module>
        <module>services/payment-service</module>
        <module>services/issuer-service</module>
        <module>services/settlement-service</module>
        <module>services/risk-service</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.ledgerflow</groupId>
                <artifactId>ledgerflow-events</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.ledgerflow</groupId>
                <artifactId>ledgerflow-starter-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.ledgerflow</groupId>
                <artifactId>ledgerflow-starter-messaging</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>io.opentelemetry.instrumentation</groupId>
                <artifactId>opentelemetry-logback-appender-1.0</artifactId>
                <version>${opentelemetry-logback-appender.version}</version>
            </dependency>
            <dependency>
                <groupId>com.microsoft.onnxruntime</groupId>
                <artifactId>onnxruntime</artifactId>
                <version>${onnxruntime.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <!-- every module's tests: keeps the OTLP exporters quiet where nothing listens on 4318 -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <!-- surefire's default includes skip *IT; integration tests run in the same phase here -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <includes>
                            <include>**/*Test.java</include>
                            <include>**/*Tests.java</include>
                            <include>**/*IT.java</include>
                        </includes>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                                <version>${lombok-mapstruct-binding.version}</version>
                            </path>
                        </annotationProcessorPaths>
                        <compilerArgs>
                            <arg>-Amapstruct.defaultComponentModel=spring</arg>
                            <arg>-Amapstruct.unmappedTargetPolicy=ERROR</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <image>
                            <name>ledgerflow/${project.artifactId}:${project.version}</name>
                            <!-- base, not the default tiny stack: tiny has no shell, so nothing in the container can run a healthcheck -->
                            <builder>paketobuildpacks/builder-noble-base</builder>
                            <env>
                                <BP_JVM_VERSION>25</BP_JVM_VERSION>
                            </env>
                        </image>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>

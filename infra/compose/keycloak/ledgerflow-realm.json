{
  "realm": "ledgerflow",
  "enabled": true,
  "sslRequired": "none",
  "requiredActions": [
    {"alias": "VERIFY_PROFILE", "name": "Verify Profile", "providerId": "VERIFY_PROFILE", "enabled": false, "defaultAction": false, "priority": 90}
  ],
  "roles": {
    "realm": [
      {"name": "ledger-write", "description": "can move money"},
      {"name": "account-read", "description": "can read accounts and balances"},
      {"name": "customer", "description": "can buy tickets"},
      {"name": "dev", "description": "can read the dev portal (prometheus/tempo)"}
    ]
  },
  "clients": [
    {
      "clientId": "ledgerflow-cli",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true
    },
    {
      "clientId": "ledgerflow-web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "attributes": {"pkce.code.challenge.method": "S256", "post.logout.redirect.uris": "+"},
      "redirectUris": ["http://localhost:5173/*", "http://localhost:8089/*"],
      "webOrigins": ["http://localhost:5173", "http://localhost:8089"]
    },
    {
      "clientId": "ledger-service",
      "enabled": true,
      "publicClient": false,
      "secret": "ledger-service-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "settlement-service",
      "enabled": true,
      "publicClient": false,
      "secret": "settlement-service-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "ops",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [{"type": "password", "value": "ops", "temporary": false}],
      "realmRoles": ["ledger-write", "account-read", "dev"]
    },
    {
      "username": "reader",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "credentials": [{"type": "password", "value": "reader", "temporary": false}],
      "realmRoles": ["account-read"]
    },
    {
      "id": "22222222-2222-2222-2222-222222222222",
      "username": "alice",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "firstName": "Alice",
      "lastName": "Shopper",
      "email": "alice@ledgerflow.example",
      "credentials": [{"type": "password", "value": "alice", "temporary": false}],
      "realmRoles": ["customer"]
    },
    {
      "id": "33333333-3333-3333-3333-333333333333",
      "username": "bob",
      "enabled": true,
      "emailVerified": true,
      "requiredActions": [],
      "firstName": "Bob",
      "lastName": "Shopper",
      "email": "bob@ledgerflow.example",
      "credentials": [{"type": "password", "value": "bob", "temporary": false}],
      "realmRoles": ["customer"]
    },
    {
      "username": "service-account-ledger-service",
      "enabled": true,
      "serviceAccountClientId": "ledger-service",
      "realmRoles": ["account-read"]
    },
    {
      "username": "service-account-settlement-service",
      "enabled": true,
      "serviceAccountClientId": "settlement-service",
      "realmRoles": ["account-read", "ledger-write"]
    }
  ]
}
